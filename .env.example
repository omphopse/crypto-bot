# ==============================================================================
# ALGOPILOT PRODUCTION / DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Live trading is strictly disabled. Use ONLY paper/demo credentials.

# Database Configuration
POSTGRES_DB=algopilot
POSTGRES_USER=algopilot
POSTGRES_PASSWORD=replace_with_secure_production_password
POSTGRES_PORT=5432
ALGOPILOT_DATABASE_URL=jdbc:postgresql://postgres:5432/algopilot
ALGOPILOT_DATABASE_USER=algopilot
ALGOPILOT_DATABASE_PASSWORD=replace_with_secure_production_password

# Redis Stream & Cache Configuration
REDIS_PORT=6379

# Server Configuration
PORT=8080

# Alpaca Paper Trading Configuration (PAPER ONLY - Live is rejected)
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=replace_with_alpaca_paper_api_key
ALPACA_API_SECRET=replace_with_alpaca_paper_api_secret

# Bybit Demo Trading Configuration (DEMO ONLY - Live is rejected)
BYBIT_BASE_URL=https://api-demo.bybit.com
BYBIT_API_KEY=replace_with_bybit_demo_api_key
BYBIT_API_SECRET=replace_with_bybit_demo_api_secret
